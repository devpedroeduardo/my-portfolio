---
import { Image } from "astro:assets";
import profileImage from "../assets/ME.png";

import { pick, type Lang } from "../i18n";

interface Props { lang?: Lang }
const { lang = "pt" } = Astro.props;

const t = pick(lang, {
  pt: {
    title: "Sobre mim",
    subtitle: "Minha trajetória",
    description: [
      "Sou Pedro Eduardo, desenvolvedor full-stack de Sobral-CE. Comecei na TI pelo suporte e pela infraestrutura de rede, e foi resolvendo os problemas de quem usa os sistemas no dia a dia que passei a construir esses sistemas.",
      "Como Analista de TI em uma distribuidora, sustentei o ERP TOTVS WinThor, escrevi consultas em Oracle e MySQL para relatórios de gestão e desenvolvi aplicações internas em React e Node.js. Hoje aplico essa experiência em projetos com Next.js, TypeScript e Supabase, com atenção a segurança e testes.",
      "Curso Engenharia de Computação na UFC e tenho formação full-stack de 1.500 horas pela Trybe. Fora do código, gosto de jogar videogame.",
    ],
    stats: [
      { label: "Anos de experiência em TI", value: "2+" },
      { label: "Horas de formação full-stack", value: "1.500" },
      { label: "Engenharia de Computação", value: "UFC" },
    ],
    photoAlt: "Foto de Pedro Eduardo",
    photoPlaceholder: "Foto de perfil",
    cv: "Baixar currículo",
  },
  en: {
    title: "About me",
    subtitle: "My path",
    description: [
      "I'm Pedro Eduardo, a full-stack developer based in Sobral, Brazil. I started in IT doing support and network infrastructure, and solving problems for the people who use systems every day is what led me to build those systems.",
      "As an IT Analyst at a distribution company, I supported the TOTVS WinThor ERP, wrote Oracle and MySQL queries for management reports and built internal applications with React and Node.js. Today I bring that experience to projects with Next.js, TypeScript and Supabase, with a focus on security and testing.",
      "I'm studying Computer Engineering at the Federal University of Ceará (UFC) and completed a 1,500-hour full-stack program at Trybe. Outside of code, I enjoy video games.",
    ],
    stats: [
      { label: "Years of IT experience", value: "2+" },
      { label: "Hours of full-stack training", value: "1,500" },
      { label: "Computer Engineering", value: "UFC" },
    ],
    photoAlt: "Photo of Pedro Eduardo",
    photoPlaceholder: "Profile photo",
    cv: "Download résumé (Portuguese)",
  },
});

const aboutData = {
  title: t.title,
  subtitle: t.subtitle,
  image: profileImage,
  description: t.description,
  stats: t.stats,
  socials: [
    {
      label: "Email",
      href: "https://mail.google.com/mail/?view=cm&fs=1&to=pedroedu77@gmail.com",
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>'
    },
    {
      label: "GitHub",
      href: "https://github.com/devpedroeduardo",
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>'
    },
    {
      label: "LinkedIn",
      href: "https://www.linkedin.com/in/devpedroeduardo/",
      icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>'
    }
  ]
};
---

<section id="about" class="relative py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>

  <div class="relative z-10 max-w-6xl mx-auto">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      
      <div class="animate-fade-in-left relative group opacity-0 flex flex-col items-center">

        <div class="absolute -inset-4 bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl opacity-20 blur-xl group-hover:opacity-40 transition-opacity duration-500"></div>
        
        <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-gray-800/40 backdrop-blur-sm aspect-[4/5] md:aspect-square w-full shadow-2xl">
          {aboutData.image ? (
            <Image 
              src={aboutData.image} 
              alt={t.photoAlt}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center bg-gray-800/50 text-neutral-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="text-sm">{t.photoPlaceholder}</span>
            </div>
          )}
          
          <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-transparent to-transparent opacity-60"></div>
        </div>

        <div class="flex gap-4 mt-8">
          {aboutData.socials.map((social) => (
            <a 
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-12 h-12 rounded-full bg-gray-800 border border-white/10 text-neutral-400 hover:text-white hover:bg-gray-700 hover:border-blue-500/50 hover:shadow-[0_0_15px_rgba(59,130,246,0.5)] transition-all duration-300 transform hover:-translate-y-1"
              aria-label={social.label}
              title={social.label}
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <div class="animate-fade-in-right delay-200 opacity-0">
        <h2 class="text-blue-400 font-medium tracking-wide text-sm uppercase mb-2">{aboutData.subtitle}</h2>
        <h3 class="text-3xl md:text-5xl font-bold text-white mb-6">{aboutData.title}</h3>
        
        <div class="space-y-4 text-neutral-300 text-lg leading-relaxed">
          {aboutData.description.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="grid grid-cols-3 gap-4 mt-8 pt-8 border-t border-white/10">
          {aboutData.stats.map((stat) => (
            <div class="text-center md:text-left">
              <div class="text-2xl md:text-3xl font-bold text-white bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-400">
                {stat.value}
              </div>
              <div class="text-xs md:text-sm text-neutral-500 uppercase tracking-wide mt-1">
                {stat.label}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8">
          <a 
            href="/docs/Curriculo_Pedro_Eduardo.pdf" 
            download="Curriculo_Pedro_Eduardo.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg transition-all duration-300 hover:scale-105 group"
          >
            <span>{t.cv}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-y-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
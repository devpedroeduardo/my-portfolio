---
// src/components/Header.astro
import { pick, homePath, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;

const t = pick(lang, {
  pt: {
    links: [['#projects', 'Projetos'], ['#services', 'Serviços'], ['#experience', 'Experiência'], ['#about', 'Sobre'], ['#contact', 'Contato']],
    switchHref: homePath.en, switchLang: 'en', switchLabel: 'EN', switchAria: 'Read in English',
  },
  en: {
    links: [['#projects', 'Projects'], ['#services', 'Services'], ['#experience', 'Experience'], ['#about', 'About'], ['#contact', 'Contact']],
    switchHref: homePath.pt, switchLang: 'pt-BR', switchLabel: 'PT', switchAria: 'Ler em português',
  },
});
---
<!-- 
  Container principal: 
  - Fixo no topo (z-50).
  - 'pointer-events-none' garante que a área vazia ao redor da barra não bloqueie cliques na página.
-->
<header class="fixed top-0 left-0 w-full z-50 py-6 pointer-events-none">
  
  <!-- 
    Navbar (Sempre visível):
    - 'pointer-events-auto' reativa os cliques nos botões.
    - Removidas as classes de opacidade e translação (hover).
    - Mantido o estilo glassmorphism.
  -->
  <nav class="pointer-events-auto flex justify-between items-center w-auto max-w-fit mx-auto px-5 sm:px-10 py-3 sm:py-4
              bg-gray-900/80 backdrop-blur-md rounded-full
              border border-white/10 shadow-lg shadow-black/10
              transition-all duration-300">

    <!-- Links de Navegação -->
    <div class="flex w-full justify-center items-center gap-x-3 sm:gap-x-8 text-xs sm:text-sm font-medium text-neutral-400 whitespace-nowrap">
      {t.links.map(([href, label]) => (
        <a href={href} class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)] transition-all duration-300">{label}</a>
      ))}

      <a
        href={t.switchHref}
        hreflang={t.switchLang}
        lang={t.switchLang}
        aria-label={t.switchAria}
        title={t.switchAria}
        class="ml-1 sm:ml-2 px-2.5 py-1 rounded-full border border-white/15 text-white/90 hover:text-white hover:border-blue-400/60 hover:bg-blue-500/10 transition-colors"
      >{t.switchLabel}</a>
    </div>
  </nav>
</header>
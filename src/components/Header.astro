---
// src/components/Header.astro
---
<!-- 
  Container principal: 
  - Fixo no topo (z-50).
  - 'pointer-events-none' garante que a área vazia ao redor da barra não bloqueie cliques na página.
-->
<header class="fixed top-0 left-0 w-full z-50 py-6 pointer-events-none">
  
  <!-- 
    Navbar (Sempre visível):
    - 'pointer-events-auto' reativa os cliques nos botões.
    - Removidas as classes de opacidade e translação (hover).
    - Mantido o estilo glassmorphism.
  -->
  <nav class="pointer-events-auto flex justify-between items-center w-auto max-w-fit mx-auto px-5 sm:px-10 py-3 sm:py-4
              bg-gray-900/80 backdrop-blur-md rounded-full
              border border-white/10 shadow-lg shadow-black/10
              transition-all duration-300">

    <!-- Links de Navegação -->
    <div class="flex w-full justify-center gap-x-4 sm:gap-x-8 text-xs sm:text-sm font-medium text-neutral-400 whitespace-nowrap">
      <a href="#projects" class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)] transition-all duration-300">Projetos</a>

      <a href="#services" class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)] transition-all duration-300">Serviços</a>

      <a href="#experience" class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)] transition-all duration-300">Experiência</a>

      <a href="#about" class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)] transition-all duration-300">Sobre</a>

      <a href="#contact" class="hover:text-white hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.6)] transition-all duration-300">Contato</a>
    </div>
  </nav>
</header>
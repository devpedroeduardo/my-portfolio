---
// src/components/Hero.astro
import { pick, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;

const t = pick(lang, {
  pt: {
    badge: 'Disponível para vagas e projetos freelance',
    name: 'Pedro Eduardo',
    role: 'Desenvolvedor Full-Stack',
    lead: 'Entreguei um e-commerce real com Pix (NestJS, Next.js e PostgreSQL) coordenando um time de agentes de IA. Antes disso, sustentei o ERP TOTVS WinThor em uma distribuidora.',
    stats: [
      ['37', 'specs entregues'],
      ['50+', 'PRs revisados'],
      ['8', 'verificações no CI'],
    ],
    stackLabel: 'Stack principal',
    caseCta: 'Ver o estudo de caso do OTILC',
    cv: 'Baixar currículo',
    cvHref: '/docs/Curriculo_Pedro_Eduardo.pdf',
    contact: 'Fale comigo',
  },
  en: {
    badge: 'Open to jobs and freelance projects',
    name: 'Pedro Eduardo',
    role: 'Full-Stack Developer',
    lead: 'I shipped a real e-commerce store with Pix payments (NestJS, Next.js and PostgreSQL) by coordinating a team of AI agents. Before that, I supported the TOTVS WinThor ERP at a distribution company.',
    stats: [
      ['37', 'specs shipped'],
      ['50+', 'PRs reviewed'],
      ['8', 'CI checks'],
    ],
    stackLabel: 'Core stack',
    caseCta: 'Read the OTILC case study',
    cv: 'Download résumé',
    cvHref: '/docs/Resume_Pedro_Eduardo.pdf',
    contact: 'Get in touch',
  },
});

const stack = ['TypeScript', 'Next.js', 'NestJS', 'PostgreSQL', 'Docker', 'Playwright', 'GitHub Actions', 'Claude Code'];
---

<section id="hero" class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden px-4 sm:px-6 lg:px-8 pt-28 pb-20">

  <div class="fixed inset-0 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 -z-50"></div>
  <div class="fixed inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-blue-900/20 via-transparent to-transparent -z-50"></div>
  <div class="fixed inset-0 bg-[radial-gradient(ellipse_at_bottom_left,_var(--tw-gradient-stops))] from-purple-900/20 via-transparent to-transparent -z-50"></div>

  <div class="relative z-10 w-full max-w-4xl mx-auto text-center flex flex-col items-center">

    <div class="hero-in" style="--d: 0.1s">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 sm:px-4 sm:py-2 mb-6 sm:mb-8 text-xs sm:text-sm font-medium text-blue-400 bg-blue-400/10 border border-blue-400/20 rounded-full backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        {t.badge}
      </span>
    </div>

    <h1 class="hero-in mb-6 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-tight tracking-tight" style="--d: 0.2s">
      <span class="block text-white">{t.name}</span>
      <span class="block bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-purple-500 to-blue-400 bg-[length:200%_auto] animate-gradient">{t.role.split(' ').map((word, i) => <>{i > 0 && ' '}<span class="whitespace-nowrap">{word}</span></>)}</span>
    </h1>

    <p class="hero-in mb-10 max-w-2xl text-base sm:text-lg md:text-xl text-neutral-300 leading-relaxed text-balance" style="--d: 0.35s">
      {t.lead}
    </p>

    <dl class="hero-in mb-10 grid w-full max-w-2xl grid-cols-3 divide-x divide-white/10 rounded-2xl border border-white/10 bg-gray-800/40 backdrop-blur-sm" style="--d: 0.5s">
      {t.stats.map(([value, label]) => (
        <div class="flex flex-col-reverse items-center gap-1 px-2 py-4 sm:py-5">
          <dt class="text-xs sm:text-sm text-neutral-400">{label}</dt>
          <dd class="font-mono text-2xl sm:text-4xl font-bold text-white">{value}</dd>
        </div>
      ))}
    </dl>

    <div class="hero-in mb-10 w-full flex flex-col sm:flex-row gap-4 justify-center items-center" style="--d: 0.65s">
      <button
        type="button"
        class="open-modal-btn w-full sm:w-auto group relative inline-flex items-center justify-center px-7 py-3.5 text-base font-semibold text-white rounded-lg overflow-hidden transition-all duration-300"
        data-id="otilc"
        data-title="OTILC Store"
        data-link="https://github.com/devpedroeduardo/otilc-store"
      >
        <span class="absolute inset-0 bg-gradient-to-r from-blue-600 to-purple-600 transition-all duration-300 group-hover:scale-110"></span>
        <span class="relative z-10 flex items-center gap-2">
          {t.caseCta}
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </span>
      </button>

      <a
        href={t.cvHref}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto group inline-flex items-center justify-center gap-2 px-7 py-3.5 text-base font-semibold text-white border-2 border-neutral-600 rounded-lg transition-all duration-300 hover:border-white"
      >
        {t.cv}
        <svg class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
      </a>

      <a href="#contact" class="text-base font-semibold text-neutral-300 underline-offset-4 hover:text-white hover:underline transition-colors">
        {t.contact}
      </a>
    </div>

    <div class="hero-in w-full" style="--d: 0.8s">
      <p class="mb-3 text-xs font-medium uppercase tracking-widest text-neutral-500">{t.stackLabel}</p>
      <ul class="flex flex-wrap justify-center gap-2 list-none p-0 m-0">
        {stack.map((tech) => (
          <li class="px-3 py-1.5 text-sm font-medium text-neutral-200 bg-white/5 border border-white/10 rounded-md">{tech}</li>
        ))}
      </ul>
    </div>

  </div>

  <div class="absolute top-1/4 left-1/4 w-48 h-48 sm:w-64 sm:h-64 bg-blue-500/10 rounded-full blur-3xl animate-float-slow pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-60 h-60 sm:w-80 sm:h-80 bg-purple-500/10 rounded-full blur-3xl animate-float-slower pointer-events-none"></div>

</section>

<style>
  /* Entrada só com CSS: o conteúdo já vem no HTML, sem depender de JavaScript. */
  .hero-in {
    animation: hero-in 0.7s ease-out both;
    animation-delay: var(--d, 0s);
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in { animation: none; }
  }
</style>
